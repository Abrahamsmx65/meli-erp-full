# ============================================================
#  Variables de entorno — copia a .env.local y llena los valores
# ============================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://iodgqfqwphchuwlynvzn.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_oguADBZ5MYROGU6OYmjS-g_b_4iVlpQ"
# Solo servidor. NUNCA la expongas al navegador.
# Cópiala de: Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mercado Libre ----------------------------------------------------------
# Se sacan de https://developers.mercadolibre.com.mx/devcenter -> tu aplicación
MELI_CLIENT_ID=""
MELI_CLIENT_SECRET=""
# Debe coincidir EXACTAMENTE con la Redirect URI registrada en la app de MELI
MELI_REDIRECT_URI="https://tu-app.vercel.app/api/meli/callback"
MELI_SITE_ID="MLM"

# --- ERP YAPANIZCEL (fundas; OTRA cuenta y OTRA app de Mercado Libre) --------
# Credenciales de la aplicación de MELI de YAPANIZCEL, distintas a las de arriba.
# Registra como Redirect URI: https://TU-APP.vercel.app/api/yapanizcel/meli/callback
MELI_YZ_CLIENT_ID=""
MELI_YZ_CLIENT_SECRET=""
# Si se deja vacía se arma con NEXT_PUBLIC_APP_URL + /api/yapanizcel/meli/callback
MELI_YZ_REDIRECT_URI=""
# El sheet de inventario de bodega (una pestaña por diseño), compartido como
# "cualquiera con el enlace puede ver". La URL normal del navegador.
YAPANIZCEL_SHEET_URL=""

# --- Inventario Industher (API del almacén) ----------------------------------
# La llave la da el sistema de inventarios de Industher. Solo servidor.
INDUSTHER_API_KEY=""
# Solo si el endpoint cambia; si se deja vacío se usa el de producción.
INDUSTHER_API_URL="https://inventarios-industher.vercel.app/api/integracion/inventario"

# A dónde se mandan las SALIDAS de TikTok para que Industher las descuente.
# Si no se pone, se usa la ruta hermana del inventario (…/integracion/salidas).
INDUSTHER_SALIDAS_URL=""

# --- Corridas desde Google Sheets --------------------------------------------
# La URL normal del sheet de corridas (docs.google.com/spreadsheets/d/…/edit).
# El sheet debe estar compartido como "cualquiera con el enlace puede VER".
CORRIDAS_SHEET_URL=""

# --- Higgsfield (videos de producto) ----------------------------------------
# Llave de API para generar videos. Se crea en https://cloud.higgsfield.ai
# Formato "ID:SECRETO". Solo servidor, nunca NEXT_PUBLIC_.
HIGGSFIELD_CREDENTIALS=""

# --- TikTok Shop (envío propio) ---------------------------------------------
# Credenciales de la APP de TikTok Shop Partner, no de la tienda: los tokens de
# la tienda se guardan en Supabase al autorizar. Se sacan de
# https://partner.tiktokshop.com -> tu app -> App Information.
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# La URL de autorización que muestra el panel de la app (dominio
# services.tiktokshop.com). Es distinta para cada app: no se puede armar a mano.
TIKTOK_AUTH_URL=""
# El service_id de la app, si su URL de autorización lo pide.
TIKTOK_SERVICE_ID=""

# --- Seguridad de los cron jobs ---------------------------------------------
# Vercel manda este secreto en el header Authorization de los cron. Inventa uno largo.
CRON_SECRET=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"
# Zona horaria del vendedor: define dónde corta el "día" para las ventas
APP_TIMEZONE="America/Mexico_City"
