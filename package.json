{
  "name": "meli-erp-full",
  "version": "1.0.0",
  "private": true,
  "description": "ERP de planeación de envíos a Mercado Envíos Full: demanda corregida por agotamientos y armado de cajas mixtas.",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.x",
    "npm": "10.9.4"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:node-version && npm run validate:vercel-node && npm run validate:lockfile && npm test && npm run typecheck",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:lockfile": "node scripts/check-lockfile-registry.mjs",
    "validate:node-version": "node scripts/check-node-version-alignment.mjs",
    "validate:vercel-node": "node scripts/check-vercel-node-version.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },

  "overrides": {
    "exceljs": {
      "archiver": "^8.0.0",
      "fast-csv": "^5.0.7",
      "unzipper": "0.12.1",
      "uuid": "^11.1.1"
    }
  }
}
