# TODO lo de aquí abajo también puede capturarse en la tabla ev_config (clave, valor)
# en vez de variables de entorno; la variable de entorno gana si existen las dos.

# Correo saliente, opción A (uso personal): tu Gmail con "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones)
SMTP_USUARIO=tucorreo@gmail.com
SMTP_CLAVE=xxxx xxxx xxxx xxxx
# Opcionales: otro servidor SMTP (por omisión Gmail, puerto 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=465

# Correo saliente, opción B: Resend con dominio propio verificado
# RESEND_API_KEY=re_...

# Cómo aparece el remitente (con SMTP puede omitirse: usa el usuario)
CORREO_REMITENTE="Boletos <tucorreo@gmail.com>"
# Copia oculta opcional de cada pedido nuevo para ti
CORREO_ORGANIZADOR=
