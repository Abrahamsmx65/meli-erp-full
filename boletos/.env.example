# Supabase del sistema de boletos (proyecto propio o el existente: las tablas llevan prefijo ev_)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...

# Dirección pública del sitio: va dentro del QR y en los enlaces de los correos
NEXT_PUBLIC_URL_BASE=https://boletos.tu-dominio.com

# Correo saliente (Resend: https://resend.com — dominio verificado)
RESEND_API_KEY=re_...
CORREO_REMITENTE="Boletos <boletos@tu-dominio.com>"
# Copia opcional de cada pedido nuevo para el organizador
CORREO_ORGANIZADOR=
